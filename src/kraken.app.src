{application, kraken, [
    {description, "Kraken - pluggable realtime pub/sub proxy (auth, broker, store and control-plane backends)"},
    {vsn, "0.9.0"},  %% persistent sessions speak MQTT 5 so the configured session expiry actually reaches the broker; previously it was silently dropped and sessions never expired
    {registered, []},
    {mod, {kraken_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        cowboy,
        gun,
        jsx,
        msgpack,
        emqtt,
        syn
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/NoLagApp/kraken"}]}
]}.
