{application, kraken, [
    {description, "Kraken - pluggable realtime pub/sub proxy (auth, broker, store and control-plane backends)"},
    {vsn, "0.8.0"},  %% an MQTT session belongs to a client instance, not a credential: a second connection for one actor no longer takes over its session
    {registered, []},
    {mod, {kraken_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        cowboy,
        gun,
        jsx,
        msgpack,
        emqtt,
        syn
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/NoLagApp/kraken"}]}
]}.
